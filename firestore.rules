rules_version = '2';

/**
 * Zásada: klient smí jen to, co po něm opravdu chceme. Připojení k akci,
 * ověření PINu a schvalování běží v Cloud Functions pod admin právy, takže
 * pravidla připojení klientovi zakazují úplně — jinak by šla serverová
 * kontrola obejít přímým zápisem dokumentu účastníka.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // Uživatelé
    // =========================================================

    /**
     * `get` ano, `list` ne. Aplikace potřebuje přečíst profil konkrétního
     * spoluúčastníka (jméno, stravovací preference do cateringu), ale nikdo
     * nesmí projít celou kolekci — byly by to e-maily, telefony a alergie
     * všech uživatelů naráz.
     */
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if false;

      /**
       * Pole o tarifu píše jen webhook z RevenueCatu pod admin právy. Kdyby si
       * je uživatel směl přepsat sám, byla by kontrola tarifu k ničemu —
       * stačilo by si do profilu napsat BUSINESS.
       */
      allow create: if isSignedIn()
                    && request.auth.uid == userId
                    && !request.resource.data.keys().hasAny(TIER_FIELDS());

      allow update: if isSignedIn()
                    && request.auth.uid == userId
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasAny(TIER_FIELDS()) == false;

      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // =========================================================
    // Akce
    // =========================================================

    match /events/{eventId} {
      allow read: if isSignedIn() && (
        resource.data.createdBy == request.auth.uid ||
        isEventParticipant(eventId)
      );

      // Zakladatel musí být ten, kdo píše — jinak by šlo založit akci
      // podepsanou cizím uživatelem. Prémiové moduly a PIN se hlídají i tady,
      // protože limity v aplikaci obejde upravený klient.
      allow create: if isSignedIn()
                    && request.resource.data.createdBy == request.auth.uid
                    && modulesAllowed(request.resource.data.get('enabledModules', []));

      // Vlastnictví akce se nepřevádí, takže createdBy musí zůstat beze změny.
      allow update: if isSignedIn()
                    && isEventOrganizer(eventId)
                    && request.resource.data.createdBy == resource.data.createdBy
                    && modulesAllowed(request.resource.data.get('enabledModules', []));
      allow delete: if isSignedIn() && isEventOrganizer(eventId);

      /**
       * PIN akce. Leží stranou od dokumentu akce, protože ten čte každý
       * účastník — a PIN má znát jen pořadatel a Cloud Function, která ho
       * ověřuje pod admin právy.
       */
      match /private/{docId} {
        allow read, write: if isSignedIn() && isEventOrganizer(eventId);
      }

      // -------------------------------------------------------
      // Účastníci
      // -------------------------------------------------------

      match /participants/{participantId} {
        allow read: if isSignedIn() && (
          isEventParticipant(eventId) ||
          resource.data.userId == request.auth.uid
        );

        /**
         * Pořadatel přidává ruční hosty a při zakládání akce sám sebe.
         * Připojení kohokoli dalšího jde výhradně přes `joinByInviteCode`,
         * která ověří kód, PIN, schvalování i kapacitu.
         */
        allow create: if isSignedIn()
                      && isEventOrganizer(eventId)
                      && (
                        request.resource.data.isManual == true ||
                        (participantId == request.auth.uid &&
                         request.resource.data.userId == request.auth.uid)
                      );

        // Účastník si smí měnit jen svou účast (RSVP, přezdívku), ne roli —
        // jinak by se sám povýšil na spolupořadatele.
        // `get` s výchozí hodnotou schválně: účastníci připojení přes pozvánku
        // nemají všechna pole vyplněná a přímé porovnání by jim znemožnilo
        // změnit i vlastní účast.
        allow update: if isSignedIn() && (
          isEventOrganizer(eventId) || (
            resource.data.userId == request.auth.uid &&
            request.resource.data.get('role', '') == resource.data.get('role', '') &&
            request.resource.data.get('userId', '') == resource.data.get('userId', '') &&
            request.resource.data.get('isManual', false) == resource.data.get('isManual', false) &&
            request.resource.data.get('linkedUserId', '') == resource.data.get('linkedUserId', '')
          )
        );

        allow delete: if isSignedIn() && (
          isEventOrganizer(eventId) ||
          resource.data.userId == request.auth.uid
        );
      }

      // -------------------------------------------------------
      // Ankety
      // -------------------------------------------------------

      match /polls/{pollId} {
        allow read: if isSignedIn() && isEventParticipant(eventId);
        allow create: if isSignedIn()
                      && isEventParticipant(eventId)
                      && request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if isSignedIn() && (
          isEventOrganizer(eventId) ||
          resource.data.createdBy == request.auth.uid
        );

        match /options/{optionId} {
          allow read: if isSignedIn() && isEventParticipant(eventId);
          allow write: if isSignedIn() && isEventParticipant(eventId);

          // ID hlasu je uid hlasujícího, takže nikdo nehlasuje za druhého
          // ani cizí hlas nepřepíše.
          match /votes/{voteId} {
            allow read: if isSignedIn() && isEventParticipant(eventId);
            allow write: if isSignedIn()
                         && isEventParticipant(eventId)
                         && voteId == request.auth.uid;
          }
        }
      }

      // -------------------------------------------------------
      // Výdaje
      // -------------------------------------------------------

      match /expenses/{expenseId} {
        allow read: if isSignedIn() && isEventParticipant(eventId) && (
          !hidesFinancials(eventId) ||
          isEventOrganizer(eventId) ||
          resource.data.paidBy == request.auth.uid
        );
        allow create: if isSignedIn() && isEventParticipant(eventId);
        allow update, delete: if isSignedIn() && (
          isEventOrganizer(eventId) ||
          resource.data.paidBy == request.auth.uid
        );

        match /splits/{splitId} {
          allow read: if isSignedIn() && isEventParticipant(eventId) && (
            !hidesFinancials(eventId) ||
            isEventOrganizer(eventId) ||
            resource.data.userId == request.auth.uid
          );
          allow write: if isSignedIn() && isEventParticipant(eventId);
        }
      }

      // -------------------------------------------------------
      // Rozpočet — spadá pod skrývání financí stejně jako výdaje
      // -------------------------------------------------------

      match /budget/{docId} {
        allow read: if isSignedIn() && isEventParticipant(eventId) && (
          !hidesFinancials(eventId) || isEventOrganizer(eventId)
        );
        allow write: if isSignedIn() && isEventOrganizer(eventId);
      }

      match /budgetCategories/{categoryId} {
        allow read: if isSignedIn() && isEventParticipant(eventId) && (
          !hidesFinancials(eventId) || isEventOrganizer(eventId)
        );
        allow write: if isSignedIn() && isEventOrganizer(eventId);

        match /expenses/{expenseId} {
          allow read: if isSignedIn() && isEventParticipant(eventId) && (
            !hidesFinancials(eventId) ||
            isEventOrganizer(eventId) ||
            resource.data.addedBy == request.auth.uid
          );
          allow create: if isSignedIn()
                        && isEventParticipant(eventId)
                        && request.resource.data.addedBy == request.auth.uid;
          allow update, delete: if isSignedIn() && (
            isEventOrganizer(eventId) ||
            resource.data.addedBy == request.auth.uid
          );
        }
      }

      // -------------------------------------------------------
      // Spolujízda
      // -------------------------------------------------------

      match /carpoolRides/{rideId} {
        allow read: if isSignedIn() && isEventParticipant(eventId);
        allow create: if isSignedIn()
                      && isEventParticipant(eventId)
                      && request.resource.data.driverId == request.auth.uid;
        allow update, delete: if isSignedIn() && (
          isEventOrganizer(eventId) ||
          resource.data.driverId == request.auth.uid
        );

        // ID pasažéra je jeho uid — nikdo nepřihlásí ani neodhlásí druhého.
        // Stav žádosti mění řidič nebo pořadatel, proto i ta druhá větev.
        match /passengers/{passengerId} {
          allow read: if isSignedIn() && isEventParticipant(eventId);
          allow write: if isSignedIn() && isEventParticipant(eventId) && (
            passengerId == request.auth.uid ||
            isEventOrganizer(eventId) ||
            get(/databases/$(database)/documents/events/$(eventId)/carpoolRides/$(rideId))
              .data.driverId == request.auth.uid
          );
        }
      }

      // -------------------------------------------------------
      // Chat — jménem sebe sama, ne cizím
      // -------------------------------------------------------

      match /messages/{messageId} {
        allow read: if isSignedIn() && isEventParticipant(eventId);
        allow create: if isSignedIn()
                      && isEventParticipant(eventId)
                      && request.resource.data.userId == request.auth.uid;
        allow update: if false;
        allow delete: if isSignedIn() && (
          isEventOrganizer(eventId) ||
          resource.data.userId == request.auth.uid
        );
      }

      // -------------------------------------------------------
      // Aktivita — záznam smí vzniknout jen pod vlastním jménem
      // a nikdo ho pak nepřepíše ani nesmaže
      // -------------------------------------------------------

      match /activity/{entryId} {
        allow read: if isSignedIn() && isEventParticipant(eventId);
        allow create: if isSignedIn()
                      && isEventParticipant(eventId)
                      && request.resource.data.actorId == request.auth.uid;
        // Historie se nepřepisuje. `readBy` se plní při zakládání, aplikace
        // hotový záznam nikdy nemění.
        allow update, delete: if false;
      }

      // Hodnocení a značka přečteno mají ID uživatele
      match /ratings/{ratingId} {
        allow read: if isSignedIn() && isEventParticipant(eventId);
        allow write: if isSignedIn()
                     && isEventParticipant(eventId)
                     && ratingId == request.auth.uid;
      }

      match /lastSeen/{userId} {
        allow read: if isSignedIn() && isEventParticipant(eventId);
        allow write: if isSignedIn()
                     && isEventParticipant(eventId)
                     && userId == request.auth.uid;
      }

      /**
       * Společné seznamy — program, úkoly, pokoje, balicí seznam, dárky.
       * Tyhle moduly jsou ze své podstaty společné, takže je smí měnit každý
       * účastník.
       *
       * Vyjmenované schválně, ne přes zástupný znak: Firestore vyhodnotí
       * všechna pravidla, která na cestu sedí, a stačí, aby přístup povolilo
       * jediné z nich. Zástupný `match /{subcollection}/{docId}` by tedy
       * zpřístupnil i `private/security`, `messages` nebo `budget` a všechna
       * přísnější pravidla výš by byla k ničemu.
       */
      match /rooms/{docId} {
        allow read, write: if isSignedIn() && isEventParticipant(eventId);
      }

      match /schedule/{docId} {
        allow read, write: if isSignedIn() && isEventParticipant(eventId);
      }

      match /tasks/{docId} {
        allow read, write: if isSignedIn() && isEventParticipant(eventId);
      }

      match /packingItems/{docId} {
        allow read, write: if isSignedIn() && isEventParticipant(eventId);
      }

      match /wishlistItems/{docId} {
        allow read, write: if isSignedIn() && isEventParticipant(eventId);
      }
    }

    // =========================================================
    // Napříč akcemi
    // =========================================================

    // Dotaz přes všechny akce — „ve kterých akcích jsem?"
    match /{path=**}/participants/{participantId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    /**
     * Žádosti o připojení. Zakládá je Cloud Function, klient je jen čte
     * a pořadatel schvaluje; ruční zakládání by obešlo ověření PINu.
     */
    match /joinRequests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isEventOrganizer(resource.data.eventId)
      );
      allow create: if false;
      allow update: if isSignedIn() && isEventOrganizer(resource.data.eventId);
      allow delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isEventOrganizer(resource.data.eventId)
      );
    }

    // Hlášení chybného překladu. Psát smí kdokoli přihlášený, číst nikdo —
    // hlášení se prohlížejí v konzoli, aplikace je zpět nenačítá.
    match /translationReports/{reportId} {
      allow read: if false;
      allow create: if isSignedIn()
                    && request.resource.data.keys().hasOnly([
                         'wrongText', 'comment', 'route', 'locale',
                         'platform', 'appVersion', 'buildNumber',
                         'userId', 'createdAt'
                       ])
                    && request.resource.data.wrongText is string
                    && request.resource.data.wrongText.size() <= 200
                    && request.resource.data.comment is string
                    && request.resource.data.comment.size() <= 500;
      allow update, delete: if false;
    }

    // =========================================================
    // Pomocné funkce
    // =========================================================

    function isSignedIn() {
      return request.auth != null;
    }

    /** Pole, která smí měnit jen server. */
    function TIER_FIELDS() {
      return ['tier', 'tierExpiresAt', 'tierUpdatedAt', 'tierSource'];
    }

    /**
     * Tarif zapisuje výhradně webhook z RevenueCatu pod admin právy — proto
     * se mu dá věřit. Chybějící pole znamená FREE, což je bezpečná výchozí
     * hodnota pro každého, kdo si nic nekoupil.
     */
    function tierOf() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('tier', 'FREE')
        : 'FREE';
    }

    function isPaid() {
      return tierOf() == 'PRO' || tierOf() == 'BUSINESS';
    }

    /** Catering, ubytování a spolujízda jsou od PRO, rozpočet až od BUSINESS. */
    function modulesAllowed(modules) {
      return !(modules.hasAny(['CATERING', 'ROOMS', 'CARPOOL']) && !isPaid())
          && !(modules.hasAny(['BUDGET']) && tierOf() != 'BUSINESS');
    }

    function isEventParticipant(eventId) {
      return exists(/databases/$(database)/documents/events/$(eventId)/participants/$(request.auth.uid))
          || get(/databases/$(database)/documents/events/$(eventId)).data.createdBy == request.auth.uid;
    }

    function isEventOrganizer(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)).data.createdBy == request.auth.uid;
    }

    function hidesFinancials(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)).data.securityEnabled == true
          && get(/databases/$(database)/documents/events/$(eventId)).data.hideFinancials == true;
    }
  }
}
